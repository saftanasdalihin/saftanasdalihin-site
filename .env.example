# Existing application variables
GEMINI_API_KEY=
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Recommended: fine-grained GitHub token with read-only Contents and Metadata
# access to public repositories. Private repositories are excluded from this public chatbot.
# Without this token, public repositories remain readable but GitHub API rate limits are lower.
GITHUB_TOKEN=

# Protect POST /api/github/sync. Use a long random secret, stored only on the server.
SAFTA_SYNC_SECRET=
